{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建当前 C++ 文件",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-all.ps1",
                "-SourceFile",
                "${file}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "close": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}